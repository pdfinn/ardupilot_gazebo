# local-dev environment template — copy to .env and edit.
# Sourced by local-dev/*.sh launchers if .env exists.

# Path to the ArduPilot source checkout (must contain Tools/autotest/sim_vehicle.py
# and build/sitl/bin/arducopter after building).
ARDUPILOT_DIR="$HOME/ardupilot"

# Gazebo line this plugin was built against. Must match the gz-sim<N> installed
# on this machine (Homebrew on macOS): garden=7, harmonic=8, ionic=9, jetty=*.
GZ_VERSION=ionic

# Optional: target Android handset for MAVLink + video forwarding.
#   "auto"      detect via adb (default)
#   "127.0.0.1" loopback only (no handset)
#   "<ip>"      specific IP, e.g. USB-tether 192.168.55.1
ANDROID_IP=auto

# Optional: TAK Server URL the operator's ATAK app dials. Informational only —
# the GCS plugin's TAK Server config lives inside ATAK on the handset, not here.
# Document where the collaborator's TAK Server is so the demo notes match.
# TAK_SERVER_URL=ssl://tak.local:8089
